# Renomeie este arquivo para .env e cole suas chaves reais.
# NUNCA coloque chaves de verdade neste arquivo (.env.example) — ele vai pro Git.

# Anthropic: usada só pra leitura/extração do PDF do regulamento (aba Regras)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Groq: provedor principal do chat (aba Consultar), detecção de ocorrências e relatório de turno
GROQ_API_KEY=gsk_sua-chave-aqui

# Cerebras: provedor reserva do chat, usado automaticamente se o Groq falhar
CEREBRAS_API_KEY=csk-sua-chave-aqui
