# Renomeie este arquivo para .env e cole suas chaves reais.
# NUNCA coloque chaves de verdade neste arquivo (.env.example) — ele vai pro Git.

# Anthropic: usada só pra leitura/extração do PDF do regulamento (aba Regras)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Gemini: provedor PRINCIPAL do chat (aba Consultar), detecção de ocorrências e relatório de
# turno — free tier generoso, é o primeiro a ser tentado. Pegue a chave em aistudio.google.com
GEMINI_API_KEY=sua-chave-aqui

# Groq: backup 1, usado automaticamente se o Gemini falhar
GROQ_API_KEY=gsk_sua-chave-aqui

# Cerebras: backup 2, usado automaticamente se o Gemini E o Groq falharem
CEREBRAS_API_KEY=csk-sua-chave-aqui
